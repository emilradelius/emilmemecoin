# ---- Telegram (required) -------------------------------------------------
# Create a bot with @BotFather, then message it once and run
#   python -m memebot.tools.whoami
# to discover your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- X / Twitter (optional but strongly recommended) ---------------------
# Third-party X mirror. twitterapi.io is the default provider.
# The official X filtered-stream API costs $5,000/mo; this is ~$0.15/1k tweets.
X_API_KEY=
X_API_BASE=https://api.twitterapi.io

# ---- AlphaLedger (optional) ---------------------------------------------
# See docs/ALPHALEDGER.md. If AlphaLedger.ai has no public API, leave blank
# and the adapter stays dormant instead of failing.
ALPHALEDGER_API_KEY=
ALPHALEDGER_API_BASE=

# ---- On-chain data -------------------------------------------------------
# PumpPortal data API is free and needs no key. A key is only required if you
# enable live trading through their Lightning API (we do NOT use that by
# default - see execution.live_mode in config.yaml).
PUMPPORTAL_API_KEY=

# Optional: your own Solana RPC (Helius/QuickNode/Triton). Improves wallet
# history backfill. Falls back to the public RPC, which is heavily throttled.
SOLANA_RPC_URL=

# ---- Live trading (ONLY if you flip execution.mode to "live") ------------
# A hot wallet private key. Use a BURNER wallet funded with only what you can
# lose. Leave blank for alerts-only or paper mode.
TRADING_WALLET_PRIVATE_KEY=

# ==========================================================================
# brokerbot - listed instruments (stocks, ETFs). Nothing below is needed for
# paper trading: `--broker paper` quotes from a free feed and opens no
# account anywhere. Fill these in only when moving to a broker demo.
# ==========================================================================

# ---- Saxo (the Nordic path) ----------------------------------------------
# A 24-hour simulation token, free, no account needed, from
#   https://www.developer.saxo/openapi/token
# Good enough to prove the adapter works. NOT good enough for a 7-day run:
# it expires overnight and the trial stops after day one.
SAXO_TOKEN=

# For a run longer than a day, register an app on the same site and use the
# OAuth2 refresh flow instead. `preflight` warns when only SAXO_TOKEN is set.
SAXO_CLIENT_ID=
SAXO_CLIENT_SECRET=
SAXO_REFRESH_TOKEN=

# ---- eToro ---------------------------------------------------------------
# From https://builders.etoro.com/. Note the cost model: eToro's round trip
# is 1.25%, against 0.48% for a Nordic broker. Run
#   python -m brokerbot.cli costs
# before deciding this is the cheap option.
ETORO_API_KEY=

# ---- News classification (optional) --------------------------------------
# Only needed for --news. The spend cap is persisted to disk and defaults to
# $10/month. Without this the rest of brokerbot runs normally.
ANTHROPIC_API_KEY=
