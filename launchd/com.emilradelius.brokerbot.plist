<?xml version="1.0" encoding="UTF-8"?>
<!--
  Records one day of the S&P + momentum overlay, on paper, once every evening.

  It holds nothing and can place no order: the CLI it runs has no broker and
  no credentials. It marks a set of weights against real closing prices and
  writes the result to data/overlay/state.json.

  Read it with:  python -m brokerbot.cli overlay
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.emilradelius.brokerbot</string>

    <key>WorkingDirectory</key>
    <string>/Users/emilradelius/Desktop/emilmemecoin</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/emilradelius/Desktop/emilmemecoin/.venv/bin/python</string>
        <string>-m</string>
        <string>brokerbot.cli</string>
        <string>overlay</string>
        <string>--run</string>
    </array>

    <!-- Without this, Python buffers stdout when it is not a terminal and the
         log sits empty while the run is perfectly healthy. An empty log is
         indistinguishable from a dead job. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <!-- 23:00 Stockholm, an hour after the US close, so the day's closing
         prices exist. A cycle missed while the laptop was shut runs when it
         next wakes; the tracker marks from the last close it saw, so a gap
         costs a day of granularity rather than corrupting the series. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>23</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/emilradelius/Desktop/emilmemecoin/data/overlay/run.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/emilradelius/Desktop/emilmemecoin/data/overlay/run.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
